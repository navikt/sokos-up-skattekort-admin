{
	"name": "sokos-up-skattekort-admin",
	"version": "1.0.0",
	"description": "Mikrofrontend for Utbetalingsportalen",
	"type": "module",
	"scripts": {
		"dev": "vite --mode mock",
		"dev:backend": "vite --mode backend",
		"build": "tsc && vite build",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@grafana/faro-web-sdk": "2.9.0",
		"@hookform/resolvers": "5.7.1",
		"@navikt/aksel-icons": "7.40.0",
		"@navikt/ds-css": "7.40.0",
		"@navikt/ds-react": "7.40.0",
		"axios": "1.19.0",
		"date-fns": "4.4.0",
		"react": "19.2.8",
		"react-datepicker": "9.1.0",
		"react-dom": "19.2.8",
		"react-hook-form": "7.85.0",
		"swr": "2.5.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@navikt/aksel-stylelint": "7.40.0",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"dependency-cruiser": "18.2.0",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"msw": "2.15.0",
		"stylelint": "17.14.1",
		"stylelint-config-standard": "40.0.0",
		"typescript": "6.0.3",
		"vite": "8.2.1",
		"vite-plugin-css-injected-by-js": "5.0.2"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"stylelint": {
		"extends": [
			"stylelint-config-standard",
			"@navikt/aksel-stylelint/recommended"
		],
		"ignoreFiles": "dist/**/*"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.7.0",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
